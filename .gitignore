# Keep the active models and their metadata, but not training checkpoints.
/ml/output/*
!/ml/output/melanoma_risk_classifier.tflite
!/ml/output/melanoma_risk_classifier.keras
!/ml/output/model_config.json
!/ml/output/evaluation_metrics.json
!/ml/output/labels.txt
!/ml/output/training_history.json

